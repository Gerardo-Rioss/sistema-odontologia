// ─── Generador ──────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

// ─── Fuente de datos ──────────────────────────────────────────
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────
enum Role {
  ADMIN
  DENTIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AppointmentType {
  LIMPIEZA
  REVISION
  URGENCIA
  TRATAMIENTO
  OTRO
}

// ─── Calendar Connection ─────────────────────────────────────
enum CalendarConnectionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageTypeEnum {
  TEXT
  TEMPLATE
  INTERACTIVE
}

enum ConversationStateEnum {
  IDLE
  GREETING
  SERVICE_SELECTION
  DATE_SELECTION
  TIME_SELECTION
  CONFIRMATION
  COMPLETED
}

// ─── Modelos ───────────────────────────────────────────────────
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  firstName      String
  lastName       String
  name           String?  // @deprecated — usar firstName + lastName
  role           Role     @default(DENTIST)
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patients            Patient[]
  appointments        Appointment[]
  passwordResetTokens PasswordResetToken[]
  calendarConnection  CalendarConnection?
  clinicSettings      ClinicSettings?

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  whatsappMessages WhatsAppMessage[]
  attachments      Attachment[]

  @@map("users")
}

model CalendarConnection {
  id               String                    @id @default(cuid())
  userId           String                    @unique
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken      String
  refreshToken     String
  tokenExpiry      DateTime
  googleCalendarId String                    @default("primary")
  googleEmail      String?
  status           CalendarConnectionStatus  @default(ACTIVE)
  googleChannelId  String?
  googleResourceId String?
  lastSyncedAt     DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@map("calendar_connections")
}

// ─── Configuración del consultorio ─────────────────────────────
model ClinicSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Datos del consultorio
  clinicName    String?
  address       String?
  city          String?
  phone         String?
  openTime      String? // Ej: "08:00"
  closeTime     String? // Ej: "20:00"
  workDays      String? // Ej: "1,2,3,4,5" (1=Lunes ... 7=Domingo)

  // Preferencias de notificación
  whatsappReminders Boolean @default(true)
  emailReminders    Boolean @default(false)
  reminderHours     Int     @default(24) // Anticipación del recordatorio

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clinic_settings")
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  birthDate DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  medicalRecord MedicalRecord?
  attachments   Attachment[]

  // Índice para filtrar pacientes por dentista
  @@index([userId])
  @@map("patients")
}

model Appointment {
  id        String            @id @default(cuid())
  date      DateTime          @db.Date
  time      String
  status    AppointmentStatus @default(PENDING)
  type      AppointmentType
  notes     String?
  googleEventId         String?  @unique
  googleCalendarId      String?
  whatsappReminderSent  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages          Message[]
  whatsappMessages  WhatsAppMessage[]

  // Índices de performance: la query más común filtra por dentista + fecha
  @@index([userId, date])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}

model Message {
  id            String   @id @default(cuid())
  content       String
  senderId      String
  receiverId    String
  appointmentId String?
  readAt        DateTime?
  createdAt     DateTime @default(now())

  sender      User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([senderId])
  @@map("messages")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model WhatsAppMessage {
  id            String          @id @default(cuid())
  waMessageId   String          @unique
  phoneNumber   String
  body          String
  direction     MessageDirection
  messageType   MessageTypeEnum @default(TEXT)
  templateName  String?
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([phoneNumber])
  @@index([appointmentId])
  @@map("whatsapp_messages")
}

model ConversationState {
  id           String                @id @default(cuid())
  phoneNumber  String
  currentState ConversationStateEnum @default(IDLE)
  context      Json                  @default("{}")
  expiresAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([phoneNumber])
  @@map("conversation_states")
}

// ─── Historia Clínica ─────────────────────────────────────────
model MedicalRecord {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  // Antecedentes médicos
  allergies   String? // Alergias conocidas
  medications String? // Medicación actual
  conditions  String? // Condiciones preexistentes (diabetes, hipertensión, etc.)
  bloodType   String? // Grupo sanguíneo (A+, A-, B+, B-, AB+, AB-, O+, O-)

  // Historia odontológica
  dentalHistory String? // Tratamientos previos, cirugías, etc.
  habits        String? // Hábitos (tabaquismo, alcohol, bruxismo, etc.)

  // Notas del profesional
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medical_records")
}

// ─── Archivos adjuntos ────────────────────────────────────────
model Attachment {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  fileName  String   // Nombre original del archivo
  fileType  String   // MIME type
  fileSize  Int      // Tamaño en bytes
  filePath  String   // Ruta de almacenamiento
  category  String?  // RADIOGRAFIA | DOCUMENTO | FOTO | RECETA | OTRO
  notes     String?  // Descripción opcional

  createdAt DateTime @default(now())

  @@index([patientId])
  @@map("attachments")
}
